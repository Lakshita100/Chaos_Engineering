<?xml version='1.0' encoding='UTF-8'?>
<project>
  <description>Windows Freestyle CI job for ResilAI. Runs unit tests, health check, Selenium, chaos experiments 1-4, and archives reports.</description>
  <keepDependencies>false</keepDependencies>
  <properties/>
  <scm class="hudson.scm.NullSCM"/>
  <canRoam>true</canRoam>
  <disabled>false</disabled>
  <blockBuildWhenDownstreamBuilding>false</blockBuildWhenDownstreamBuilding>
  <blockBuildWhenUpstreamBuilding>false</blockBuildWhenUpstreamBuilding>
  <triggers/>
  <concurrentBuild>false</concurrentBuild>
  <builders>
    <hudson.tasks.BatchFile>
      <command>cd /d D:\UserData\Desktop\ResilAI &amp;&amp; .venv\Scripts\python.exe -m pip install -r app\requirements.txt</command>
    </hudson.tasks.BatchFile>
    <hudson.tasks.BatchFile>
      <command>cd /d D:\UserData\Desktop\ResilAI &amp;&amp; if not exist results mkdir results &amp;&amp; .venv\Scripts\python.exe -m pytest tests\ -v --junitxml=results\unit-test-results.xml</command>
    </hudson.tasks.BatchFile>
    <hudson.tasks.BatchFile>
      <command>cd /d D:\UserData\Desktop\ResilAI &amp;&amp; powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts\jenkins_health_check.ps1</command>
    </hudson.tasks.BatchFile>
    <hudson.tasks.BatchFile>
      <command>cd /d D:\UserData\Desktop\ResilAI &amp;&amp; set &quot;APP_URL=http://localhost:5000&quot; &amp;&amp; .venv\Scripts\python.exe -m pytest selenium\ -v --junitxml=results\selenium-test-results.xml</command>
    </hudson.tasks.BatchFile>
    <hudson.tasks.BatchFile>
      <command>cd /d D:\UserData\Desktop\ResilAI &amp;&amp; .venv\Scripts\python.exe chaos\run_experiments.py --requests 10 --duration 5 --workers 2 --mb 64 --delay 200 1 2 3 4</command>
    </hudson.tasks.BatchFile>
    <hudson.tasks.BatchFile>
      <command>echo Existing Flask service is managed by Docker; no process cleanup needed.</command>
    </hudson.tasks.BatchFile>
    <hudson.tasks.BatchFile>
      <command>if not exist &quot;%WORKSPACE%\results&quot; mkdir &quot;%WORKSPACE%\results&quot; &amp;&amp; xcopy /E /I /Y D:\UserData\Desktop\ResilAI\results &quot;%WORKSPACE%\results&quot;</command>
    </hudson.tasks.BatchFile>
  </builders>
  <publishers>
    <hudson.tasks.ArtifactArchiver>
      <artifacts>results/**/*</artifacts>
      <latestOnly>false</latestOnly>
    </hudson.tasks.ArtifactArchiver>
  </publishers>
  <buildWrappers/>
</project>
